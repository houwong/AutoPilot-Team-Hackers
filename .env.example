# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO
# Secret used only by the five-minute Windows Task Scheduler queue tick.
# Leave empty if the scheduler is not enabled.
QUEUE_TICK_TOKEN=

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev

# --- Supervity Auto ---
# Workflow IDs change whenever a workflow is recreated in Auto. If runs start
# failing with {"error":"Workflow not found"}, re-read them from
# GET https://auto-workflow-api.supervity.ai/api/v1/workflows
AUTO_API_KEY=
AUTO_ORG=Team Hackers
# The rebuilt orchestrator (6 Aug). The Round 1/2 original still exists and
# still runs — set this to 019fd290-bdf0-7000-88b9-2b00a7dbb7fc to roll back.
AUTO_WF_ORCHESTRATOR=019fd826-9991-7000-873c-ea6fca4c660b

# Queue planning rollout. Keep legacy until both new imports are validated;
# switching to supervity_v2 is an explicit, reversible change.
QUEUE_PLANNER_MODE=legacy
AUTO_WF_OP1_PLANNER=
AUTO_WF_QUEUE_PLANNER=
QUEUE_PLANNER_FRESH_TTL=60
QUEUE_PLANNER_STALE_TTL=600

# The API host is auto-workflow-api.supervity.ai, NOT the auto.supervity.ai
# given in the published docs. The documented host returns
# 400 {"message":"Unexpected Server Error"} even unauthenticated, which reads
# like a broken key rather than a wrong URL. Left unset the code uses the
# correct host; set it only to point at a different environment.
AUTO_BASE_URL=https://auto-workflow-api.supervity.ai

# Sent as x-user-timezone on every call. Auto resolves relative dates against
# it, so a mismatch shifts every SLA calculation by the offset.
AUTO_TIMEZONE=Asia/Kuala_Lumpur

# --- Supabase (Command Center writes human CAB decisions only) ---
SUPABASE_URL=
SUPABASE_KEY=
